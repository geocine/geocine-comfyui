#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ./publish [patch|minor|major]" >&2
}

bump="${1:-patch}"
case "$bump" in
    patch|minor|major)
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 1
        ;;
esac

cd "$(dirname "$0")"

if [ ! -f pyproject.toml ]; then
    echo "pyproject.toml was not found." >&2
    exit 1
fi

if [ -n "$(git status --short)" ]; then
    echo "Refusing to publish with uncommitted changes:" >&2
    git status --short >&2
    echo "Commit or stash changes first, then rerun ./publish $bump." >&2
    exit 1
fi

PYTHON="${PYTHON:-python}"

old_version="$("$PYTHON" - <<'PY'
from pathlib import Path
import re

text = Path("pyproject.toml").read_text()
match = re.search(r'(?m)^version = "(\d+)\.(\d+)\.(\d+)"$', text)
if not match:
    raise SystemExit("Could not find semantic version in pyproject.toml")
print(match.group(0).split('"')[1])
PY
)"

new_version="$("$PYTHON" - "$bump" <<'PY'
from pathlib import Path
import re
import sys

bump = sys.argv[1]
path = Path("pyproject.toml")
text = path.read_text()
match = re.search(r'(?m)^version = "(\d+)\.(\d+)\.(\d+)"$', text)
if not match:
    raise SystemExit("Could not find semantic version in pyproject.toml")

major, minor, patch = map(int, match.groups())
if bump == "major":
    major += 1
    minor = 0
    patch = 0
elif bump == "minor":
    minor += 1
    patch = 0
else:
    patch += 1

new_version = f"{major}.{minor}.{patch}"
text = re.sub(
    r'(?m)^version = "\d+\.\d+\.\d+"$',
    f'version = "{new_version}"',
    text,
    count=1,
)
path.write_text(text)
print(new_version)
PY
)"

echo "Bumped geocine-comfyui from $old_version to $new_version"
git add pyproject.toml
git commit -m "chore: release v$new_version"

echo "Publishing geocine-comfyui $new_version"
"$PYTHON" -m comfy node publish
